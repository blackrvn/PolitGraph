@inherits LayoutComponentBase

<div class="app-shell">

    <div class="top-row">
        <a class="brand" href="/" aria-label="politgraph — home">
            <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
                <g class="brand__edges">
                    <line x1="9" y1="10" x2="22" y2="7" />
                    <line x1="9" y1="10" x2="11" y2="23" />
                    <line x1="22" y1="7" x2="24" y2="20" />
                    <line x1="11" y1="23" x2="24" y2="20" />
                </g>
                <circle class="brand__node" cx="9" cy="10" r="3" />
                <circle class="brand__node" cx="11" cy="23" r="3" />
                <circle class="brand__node" cx="24" cy="20" r="3" />
                <circle class="brand__node brand__node--accent" cx="22" cy="7" r="3.6" />
            </svg>
            <span class="brand__word">politgraph</span>
        </a>
        <div>
            <a href="https://github.com/blackrvn/PolitGraph" target="_blank">GitHub</a>
        </div>
    </div>

    <main class="app-body">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
