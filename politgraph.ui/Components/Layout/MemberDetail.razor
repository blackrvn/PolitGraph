@inject ISelectionService _selectionService
@inject IAffairsData _db
@implements IDisposable

@if(_member == null)
{
    <div>
        <h4>Keine Auswahl</h4>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="member-header">
            <img src="https://files.openparldata.ch/images/persons/original/CHE-@(_member?.MemberId)_v1.jpg"
                 alt="@($"{_member?.FirstName} {_member?.LastName}")"
                 class="member-thumb" />
            <div class="member-info">
                <h4>@(_member?.FirstName) @(_member?.LastName)</h4>
                <p>@(_member?.MemberId)</p>
                <p>@(_member?.Party)</p>
            </div>
        </div>


        @if(_affairs == null)
        {
            <p>Lade Geschäfte...</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Titel</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var affair in _affairs)
                    {
                        <tr>
                            <td>
                                <a target="_blank" href="https://openparldata.ch/item/affairs/@affair.AffairId">@affair.AffairId</a>
                            </td>
                            <td>@affair.Title</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}


@code {
    private MemberModel? _member;
    private List<AffairModel>? _affairs;

    protected override void OnInitialized()
    {

        _selectionService.OnSelectionChanged += OnChanged;
    }

    private async void OnChanged()
    {
        _member = _selectionService.Selection;
        if(_member != null)
        {
            _affairs = (await _db.GetAffairsOfMemberAsync(_member.MemberId))
                .OrderBy(a => a.UpdatedAt)
                .Reverse()
                .ToList();
        }
        // Damit das UI aktuell bleibt
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _selectionService.OnSelectionChanged -= OnChanged;
    }

}