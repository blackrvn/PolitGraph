@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="cy-wrap">
    <div @ref=GraphContainer class="cy"></div>

    <div class="legend">
        @if (Parties == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <span class="legend-title">Partei</span>
            @foreach (var party in FilterGroups.GetPartyGroups())
            {
                <button type="button" class="@PartyPillClass(party)" aria-pressed="@IsPartyOn(party)"
                        @onclick="() => ToggleParty(party)">
                    <span class="pill__dot" style="background-color:@FilterGroups.GetColorForParty(party)"></span>
                    @party
                </button>
            }

            <span class="legend-sep"></span>

            <span class="legend-title">Status</span>
            <button type="button" class='@StatePillClass("Aktiv")' aria-pressed='@IsStateOn("Aktiv")'
                    @onclick='() => ToggleState("Aktiv")'>
                <span class="pill__dot pill__dot--active"></span>
                Aktiv
            </button>
            <button type="button" class='@StatePillClass("Inaktiv")' aria-pressed='@IsStateOn("Inaktiv")'
                    @onclick='() => ToggleState("Inaktiv")'>
                <span class="pill__dot pill__dot--inactive"></span>
                Inaktiv
            </button>

            <span class="legend-sep"></span>

            <span class="legend-title">Ähnlichkeit</span>
            <span class="edge-item">
                <span class="edge-sample edge-sample--high"></span>
                Hoch
            </span>
            <span class="edge-item">
                <span class="edge-sample edge-sample--mid"></span>
                Mittel
            </span>
            <span class="edge-item">
                <span class="edge-sample edge-sample--low"></span>
                Gering
            </span>
        }
    </div>
</div>

